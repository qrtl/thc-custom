<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quantity_history" model="ir.ui.view">
        <field name="name">stock.quantity.history</field>
        <field name="model">stock.quantity.history</field>
        <field name="inherit_id" ref="stock.view_stock_quantity_history" />
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='open_at_date']" position="after">
                <button
                    name="open_at_actual_date_location"
                    string="Inventory Location as of Actual Date"
                    type="object"
                    class="btn-primary"
                    invisible="context.get('active_model') != 'stock.quant'"
                />
            </xpath>
        </field>
    </record>
</odoo>
