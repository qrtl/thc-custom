<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="custom_stock_account_report_invoice_document"
        inherit_id="stock_account.stock_account_report_invoice_document"
        priority="100"
    >
        <xpath expr="//t[contains(@t-esc, 'quantity')]" position="replace">
            <!-- Call _format_quantity instead of using <span t-field=""> to avoid misalignment caused by the different behaviors of the t tag and span tag. -->
            <t t-esc="snln_line['lot_quantity']._format_quantity()" />
        </xpath>
    </template>
</odoo>
