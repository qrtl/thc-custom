<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_group_code_view_tree" model="ir.ui.view">
        <field name="name">product.group.code.tree</field>
        <field name="model">product.group.code</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="product_group_code_view_form" model="ir.ui.view">
        <field name="name">product.group.code.form</field>
        <field name="model">product.group.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <group>
                        <field name="name" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_group_code_view_search" model="ir.ui.view">
        <field name="name">product.group.code.search</field>
        <field name="model">product.group.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record id="product_group_code_action" model="ir.actions.act_window">
        <field name="name">Product Group Codes</field>
        <field name="res_model">product.group.code</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="product_group_code_menu"
        parent="stock.menu_product_in_config_stock"
        action="product_group_code_action"
        sequence="20"
    />
</odoo>
