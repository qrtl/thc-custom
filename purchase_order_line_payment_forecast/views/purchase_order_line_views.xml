<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_line_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit</field>
        <field name="model">purchase.order.line</field>
        <field
            name="inherit_id"
            ref="purchase_order_line_menu.purchase_order_line_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="payment_term_id" optional="show" />
                <field name="expected_payment_date" optional="show" />
                <field name="price_subtotal_billed" optional="show" />
                <field name="price_subtotal_unbilled" optional="show" />
                <field name='company_currency_id' invisible="1" />
                <field
                    name="price_subtotal_unbilled_curr"
                    sum="Total"
                    string="Total Subtotal Unbilled (Company Currency)"
                    options="{'currency_field': 'company_currency_id'}"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
